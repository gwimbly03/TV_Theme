@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Write an OpenWeather snapshot for the private BRAVIA weather card."""
+
+import argparse
+import json
+import os
+import tempfile
+import time
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from urllib.error import HTTPError
+from urllib.parse import urlencode
+from urllib.request import urlopen
+
+API = "https://api.openweathermap.org/data/2.5"
+
+
+def fetch(endpoint, params):
+    with urlopen(f"{API}/{endpoint}?{urlencode(params)}", timeout=15) as response:
+        return json.load(response)
+
+
+def condition(reading):
+    weather = reading["weather"][0]
+    code = weather["id"] // 100
+    icon = {2: "storm", 3: "rain", 5: "rain", 6: "snow"}.get(code, "cloudy")
+    if weather["id"] == 800:
+        icon = "clear"
+    description = weather["description"]
+    return {"icon": icon, "condition": description[:1].upper() + description[1:]}
+
+
+def snapshot(current, forecast, city, now):
+    offset = timezone(timedelta(seconds=forecast["city"]["timezone"]))
+    upcoming = sorted(
+        (reading for reading in forecast["list"] if reading["dt"] > now),
+        key=lambda reading: reading["dt"],
+    )[:4]
+    if len(upcoming) != 4:
+        raise ValueError("OpenWeather did not return four upcoming forecast periods")
+    return {
+        "city": city,
+        **condition(current),
+        "temperature": round(current["main"]["temp"]),
+        "feels_like": round(current["main"]["feels_like"]),
+        "expires_at": now + 3 * 3600,
+        "hours": [
+            {
+                "time": datetime.fromtimestamp(reading["dt"], offset).strftime("%H:%M"),
+                "temperature": round(reading["main"]["temp"]),
+                **condition(reading),
+            }
+            for reading in upcoming
+        ],
+    }
+
+
+def write_snapshot(output, data):
+    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=output.parent,
+                                     delete=False) as temporary:
+        staged = Path(temporary.name)
+        try:
+            json.dump(data, temporary, ensure_ascii=False, indent=2)
+            temporary.write("\n")
+            temporary.close()
+            staged.replace(output)
+        finally:
+            staged.unlink(missing_ok=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--lat", type=float, required=True, help="Approximate city latitude")
+    parser.add_argument("--lon", type=float, required=True, help="Approximate city longitude")
+    parser.add_argument("--city", required=True, help="City name to show on the card")
+    parser.add_argument("--output", type=Path, required=True, help="Destination weather.json path")
+    args = parser.parse_args()
+    if not (-90 <= args.lat <= 90 and -180 <= args.lon <= 180):
+        parser.error("Invalid coordinates")
+    key = os.environ.get("OPENWEATHER_API_KEY")
+    if not key:
+        parser.error("Set OPENWEATHER_API_KEY in the environment")
+
+    params = {"lat": args.lat, "lon": args.lon, "units": "metric", "appid": key}
+    try:
+        current = fetch("weather", params)
+        forecast = fetch("forecast", params)
+        write_snapshot(args.output, snapshot(current, forecast, args.city, int(time.time())))
+    except HTTPError as error:
+        parser.exit(1, f"OpenWeather request failed (HTTP {error.code})\n")
+    except (OSError, KeyError, IndexError, TypeError, ValueError):
+        parser.exit(1, "Could not fetch or save a valid OpenWeather snapshot\n")
+
+
+if __name__ == "__main__":
+    main()
