+package com.gathin.tvhome;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.BitmapFactory;
+import android.graphics.drawable.GradientDrawable;
+import android.text.TextUtils;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.BaseAdapter;
+import android.widget.GridView;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+
+/** A D-pad gallery for the existing theme wallpaper preference. */
+final class WallpaperMenu {
+    private WallpaperMenu() {}
+
+    static void show(Context context, Runnable onChange) {
+        File dir = Config.dir(context);
+        List<File> images = new ArrayList<>(WallpaperRotation.images(
+                dir == null ? null : new File(dir, "wallpapers")));
+        File single = dir == null ? null : new File(dir, Config.WALLPAPER_NAME);
+        if (single != null && single.isFile()) images.add(0, single);
+        SharedPreferences prefs = context.getSharedPreferences(Config.SETTINGS_NAME, Context.MODE_PRIVATE);
+        String current = prefs.getString(Config.WALLPAPER_CHOICE_KEY, null);
+
+        GridView grid = new GridView(context);
+        grid.setNumColumns(3);
+        grid.setHorizontalSpacing(dp(context, 8));
+        grid.setVerticalSpacing(dp(context, 8));
+        grid.setPadding(dp(context, 16), dp(context, 8), dp(context, 16), dp(context, 12));
+        GradientDrawable focus = new GradientDrawable();
+        focus.setColor(0x208BD8FF);
+        focus.setStroke(dp(context, 2), 0xFFBFE9FF);
+        focus.setCornerRadius(dp(context, 8));
+        grid.setSelector(focus);
+        grid.setDrawSelectorOnTop(true);
+        grid.setAdapter(new BaseAdapter() {
+            @Override public int getCount() { return images.size() + 2; }
+            @Override public File getItem(int position) { return position < 2 ? null : images.get(position - 2); }
+            @Override public long getItemId(int position) { return position; }
+
+            @Override
+            public View getView(int position, View recycled, ViewGroup parent) {
+                LinearLayout tile = (LinearLayout) recycled;
+                if (tile == null) {
+                    tile = new LinearLayout(context);
+                    tile.setOrientation(LinearLayout.VERTICAL);
+                    tile.setPadding(dp(context, 4), dp(context, 4), dp(context, 4), dp(context, 4));
+                    tile.setBackgroundColor(0xFF26323D);
+                    ImageView image = new ImageView(context);
+                    image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+                    tile.addView(image, new LinearLayout.LayoutParams(-1, dp(context, 84)));
+                    TextView name = new TextView(context);
+                    name.setTextColor(0xFFF0F5FA);
+                    name.setSingleLine(true);
+                    name.setEllipsize(TextUtils.TruncateAt.END);
+                    name.setGravity(Gravity.CENTER);
+                    tile.addView(name, new LinearLayout.LayoutParams(-1, dp(context, 28)));
+                }
+                ImageView image = (ImageView) tile.getChildAt(0);
+                TextView name = (TextView) tile.getChildAt(1);
+                File file = getItem(position);
+                image.setVisibility(file == null ? View.INVISIBLE : View.VISIBLE);
+                image.setImageBitmap(file == null ? null : thumbnail(file));
+                name.setText(position == 0 ? context.getString(R.string.wallpaper_theme_default)
+                        : position == 1 ? context.getString(R.string.wallpaper_none)
+                        : file.getName().replaceFirst("^\\d+-", "").replaceFirst("\\.[^.]+$", "").replace('-', ' '));
+                if (file == null) {
+                    // The two actions have their labels centered in the same space as the photo tiles.
+                    image.setVisibility(View.GONE);
+                    name.getLayoutParams().height = dp(context, 112);
+                } else {
+                    name.getLayoutParams().height = dp(context, 28);
+                }
+                return tile;
+            }
+        });
+        AlertDialog dialog = new AlertDialog.Builder(context)
+                .setTitle(R.string.wallpaper_label)
+                .setView(grid)
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+        grid.setOnItemClickListener((parent, view, position, id) -> {
+            SharedPreferences.Editor edit = prefs.edit();
+            if (position == 0) edit.remove(Config.WALLPAPER_CHOICE_KEY);
+            else edit.putString(Config.WALLPAPER_CHOICE_KEY, position == 1 ? "none" : images.get(position - 2).getName());
+            edit.apply();
+            dialog.dismiss();
+            onChange.run();
+        });
+        dialog.show();
+        if (dialog.getWindow() != null) {
+            int width = context.getResources().getDisplayMetrics().widthPixels;
+            int height = context.getResources().getDisplayMetrics().heightPixels;
+            dialog.getWindow().setLayout(Math.min(dp(context, 610), width * 9 / 10),
+                    Math.min(dp(context, 475), height * 9 / 10));
+        }
+        int selected = "none".equals(current) ? 1 : 0;
+        for (int i = 0; i < images.size(); i++) {
+            if (images.get(i).getName().equals(current)) selected = i + 2;
+        }
+        grid.requestFocus();
+        grid.setSelection(selected);
+    }
+
+    private static android.graphics.Bitmap thumbnail(File file) {
+        BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inJustDecodeBounds = true;
+        BitmapFactory.decodeFile(file.getPath(), options);
+        options.inJustDecodeBounds = false;
+        options.inSampleSize = 1;
+        while (Math.max(options.outWidth, options.outHeight) / options.inSampleSize > 480) {
+            options.inSampleSize *= 2;
+        }
+        options.inPreferredConfig = android.graphics.Bitmap.Config.RGB_565;
+        return BitmapFactory.decodeFile(file.getPath(), options);
+    }
+
+    private static int dp(Context context, int value) {
+        return Math.round(value * context.getResources().getDisplayMetrics().density);
+    }
+}
