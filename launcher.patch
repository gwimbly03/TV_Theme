+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.view.View;
+
+/** A few precipitation marks in the open wallpaper area of Home. */
+final class WeatherBackdrop extends View {
+    private static final float[] X = {0.28f, 0.43f, 0.55f, 0.65f, 0.74f, 0.87f};
+    private static final float[] Y = {0.34f, 0.63f, 0.44f, 0.71f, 0.29f, 0.55f};
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path drop = new Path();
+    private final float density;
+    private String condition = "";
+
+    WeatherBackdrop(Context context) {
+        super(context);
+        density = getResources().getDisplayMetrics().density;
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        paint.setStrokeCap(Paint.Cap.ROUND);
+        setVisibility(GONE);
+    }
+
+    void setCondition(String next) {
+        condition = next;
+        setVisibility("rain".equals(next) || "storm".equals(next) || "snow".equals(next) ? VISIBLE : GONE);
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        boolean snow = "snow".equals(condition);
+        for (int i = 0; i < X.length; i++) {
+            float x = getWidth() * X[i];
+            float y = getHeight() * Y[i];
+            float size = (4f + i % 3) * density;
+            if (snow) {
+                paint.setColor(i % 2 == 0 ? 0x9ADDEFFF : 0x6ADDEFFF);
+                paint.setStrokeWidth(density);
+                for (int axis = 0; axis < 3; axis++) {
+                    double angle = axis * Math.PI / 3;
+                    float dx = size * (float) Math.cos(angle);
+                    float dy = size * (float) Math.sin(angle);
+                    canvas.drawLine(x - dx, y - dy, x + dx, y + dy, paint);
+                }
+            } else {
+                paint.setColor(i % 2 == 0 ? 0x9481D6F2 : 0x6481D6F2);
+                drop.reset();
+                drop.moveTo(x + size * 0.45f, y - size);
+                drop.cubicTo(x + size * 0.41f, y - size * 0.25f, x + size * 0.78f, y + size * 0.55f,
+                        x, y + size * 0.68f);
+                drop.cubicTo(x - size * 0.88f, y + size * 0.55f, x - size * 0.55f, y - size * 0.18f,
+                        x + size * 0.45f, y - size);
+                drop.close();
+                canvas.drawPath(drop, paint);
+            }
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WeatherCard.java b/launcher/app/src/main/java/com/gathin/tvhome/WeatherCard.java
