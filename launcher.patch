+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.SystemClock;
+import android.text.TextUtils;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+final class WirelessPanel extends FrameLayout {
+    static final int WIDTH = 534;
+    static final int HEIGHT = 380;
+    private static final int[] RING_RADII = {66, 74, 81};
+    private final float density;
+    private final boolean animate;
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF ring = new RectF();
+    private final TextView hub;
+    private final TextView wifiTab;
+    private final TextView bluetoothTab;
+    private final TextView action;
+    private final TextView[] nodes = new TextView[6];
+    private final String connection;
+    private final String[] networkNames;
+    private final Runnable wifiSettings;
+    private final Runnable bluetoothSettings;
+
+    WirelessPanel(Context context, String connection, String[] networkNames, boolean animate,
+                  Runnable wifiSettings, Runnable bluetoothSettings, Runnable vpnSettings) {
+        super(context);
+        density = getResources().getDisplayMetrics().density;
+        this.connection = connection;
+        this.networkNames = networkNames;
+        this.animate = animate;
+        this.wifiSettings = wifiSettings;
+        this.bluetoothSettings = bluetoothSettings;
+        setBackground(surface(0xF2111320, 0xFF252A3E, 20));
+        setWillNotDraw(false);
+        int[][] positions = {{68, 76}, {351, 76}, {12, 155}, {378, 155}, {67, 239}, {351, 239}};
+        for (int i = 0; i < nodes.length; i++) {
+            nodes[i] = label("", positions[i][0], positions[i][1], 144, 34, 12);
+            nodes[i].setBackground(surface(0xEC1C2031, 0xFF292F45, 10));
+        }
+        hub = label("", 209, 116, 116, 116, 15);
+        hub.setBackground(surface(0xFF354C8B, 0xFF7087C6, 58));
+        wifiTab = label("Wi-Fi", 117, 324, 99, 34, 14);
+        bluetoothTab = label("Bluetooth", 224, 324, 99, 34, 14);
+        action = label("", 331, 324, 103, 34, 14);
+        wifiTab.setOnClickListener(v -> select(false));
+        bluetoothTab.setOnClickListener(v -> select(true));
+        if (vpnSettings != null) {
+            TextView vpn = label("VPN", 444, 324, 72, 34, 13);
+            vpn.setOnClickListener(v -> vpnSettings.run());
+            style(vpn, false);
+        }
+        select(false);
+    }
+
+    private TextView label(String text, int x, int y, int width, int height, int size) {
+        TextView view = new TextView(getContext());
+        view.setText(text);
+        view.setTextSize(size);
+        view.setTextColor(0xFFF0F2FF);
+        view.setTypeface(Typeface.MONOSPACE, Typeface.BOLD);
+        view.setGravity(Gravity.CENTER);
+        view.setMaxLines(2);
+        view.setEllipsize(TextUtils.TruncateAt.END);
+        view.setPadding(dp(7), 0, dp(7), 0);
+        LayoutParams params = new LayoutParams(dp(width), dp(height), Gravity.LEFT | Gravity.TOP);
+        params.leftMargin = dp(x);
+        params.topMargin = dp(y);
+        addView(view, params);
+        return view;
+    }
+
+    private GradientDrawable surface(int fill, int edge, int radius) {
+        GradientDrawable drawable = new GradientDrawable();
+        drawable.setColor(fill);
+        drawable.setCornerRadius(dp(radius));
+        if (edge != 0) drawable.setStroke(Math.max(1, dp(1)), edge);
+        return drawable;
+    }
+
+    private void select(boolean bluetooth) {
+        hub.setText(bluetooth ? "Bluetooth\nAccessories" : "Wi-Fi\n" + connection);
+        action.setText(bluetooth ? "Pair device" : "Networks");
+        Runnable settings = bluetooth ? bluetoothSettings : wifiSettings;
+        action.setOnClickListener(v -> settings.run());
+        for (int i = 0; i < nodes.length; i++) {
+            String name = !bluetooth && i < networkNames.length ? networkNames[i] : "";
+            nodes[i].setText(name);
+            nodes[i].setVisibility(name.isEmpty() ? INVISIBLE : VISIBLE);
+        }
+        style(wifiTab, !bluetooth);
+        style(bluetoothTab, bluetooth);
+        style(action, false);
+        invalidate();
+    }
+
+    private void style(TextView button, boolean selected) {
+        button.setFocusable(true);
+        button.setOnFocusChangeListener((v, focused) -> paintButton(button, selected));
+        paintButton(button, selected);
+    }
+
+    private void paintButton(TextView button, boolean selected) {
+        button.setBackground(surface(selected ? 0xFF354C8B : 0xFF262B3E,
+                button.isFocused() ? 0xFFC3D4FF : 0, 10));
+    }
+
+    void focusTabs() {
+        wifiTab.requestFocusFromTouch();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        float x = dp(267);
+        float y = dp(174);
+        for (TextView node : nodes) {
+            if (node.getVisibility() != VISIBLE) continue;
+            paint.setColor(0x665E76B7);
+            paint.setStrokeWidth(dp(1));
+            canvas.drawLine(x, y, node.getLeft() + node.getWidth() / 2f,
+                    node.getTop() + node.getHeight() / 2f, paint);
+        }
+        boolean spinning = animate && isShown() && hasWindowFocus()
+                && android.animation.ValueAnimator.areAnimatorsEnabled();
+        float phase = spinning ? (SystemClock.uptimeMillis() % 3600L) / 10f : 0f;
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeCap(Paint.Cap.ROUND);
+        paint.setStrokeWidth(dp(2));
+        for (int radius : RING_RADII) {
+            float r = dp(radius);
+            ring.set(x - r, y - r, x + r, y + r);
+            paint.setColor(0x663D508B);
+            canvas.drawOval(ring, paint);
+            paint.setColor(0xFF7795EA);
+            canvas.drawArc(ring, (radius == 74 ? -phase : phase) + radius * 4, 49, false, paint);
+        }
+        paint.setStyle(Paint.Style.FILL);
+        if (spinning) postInvalidateDelayed(33L);
+    }
+
+    @Override
+    public void onWindowFocusChanged(boolean focused) {
+        super.onWindowFocusChanged(focused);
+        if (focused) invalidate();
+    }
+
+    private int dp(int value) {
+        return Math.round(value * density);
+    }
+}
