--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WeatherCard.java
@@ -0,0 +1,249 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.FileObserver;
+import android.text.TextUtils;
+import android.util.AttributeSet;
+import android.view.Gravity;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+/** Displays a small, locally supplied forecast snapshot. The launcher does not fetch forecasts. */
+public final class WeatherCard extends LinearLayout {
+    private static final int SECONDARY = 0xFFD4DEE8;
+    private static final int ACCENT = 0xFF81D6F2;
+
+    private final Paint precipitation = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final String FILE_NAME = "weather.json";
+
+    private final Runnable refresh = this::reload;
+    private FileObserver watcher;
+    private String currentIcon = "";
+    private float cardScale = 1f;
+    private WeatherBackdrop backdrop;
+
+    public WeatherCard(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setOrientation(VERTICAL);
+        setWillNotDraw(false);
+        setCardScale(1f);
+    }
+
+    void setCardScale(float scale) {
+        cardScale = scale;
+        setPadding(dp(16), dp(12), dp(16), dp(12));
+        GradientDrawable background = new GradientDrawable(
+                GradientDrawable.Orientation.TL_BR, new int[]{0xDF233D50, 0xED18212D});
+        background.setCornerRadius(dp(14));
+        setBackground(background);
+    }
+
+    void setWallpaperAccent(int accent) {
+        ((GradientDrawable) getBackground()).setColors(new int[]{
+                MainActivity.tint(accent, 0x233D50, accent == 0 ? 0f : 0.28f, 223),
+                MainActivity.tint(accent, 0x18212D, accent == 0 ? 0f : 0.12f, 237)});
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        File dir = Config.dir(getContext());
+        if (dir == null) return;
+        // The string constructor is supported by the launcher's API 26 minimum.
+        watcher = new FileObserver(dir.getAbsolutePath(), FileObserver.CLOSE_WRITE | FileObserver.MOVED_TO
+                | FileObserver.DELETE | FileObserver.MOVED_FROM) {
+            @Override
+            public void onEvent(int event, String path) {
+                if (FILE_NAME.equals(path)) post(refresh);
+            }
+        };
+        watcher.startWatching();
+        reload();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (watcher != null) {
+            watcher.stopWatching();
+            watcher = null;
+        }
+        removeCallbacks(refresh);
+        super.onDetachedFromWindow();
+    }
+
+    void useCompactLayout(WeatherBackdrop backdrop) {
+        this.backdrop = backdrop;
+        setGravity(Gravity.CENTER_VERTICAL);
+        setPadding(dp(13), 0, dp(13), 0);
+    }
+
+    void reload() {
+        removeCallbacks(refresh);
+        if (!isAttachedToWindow()) return;
+        File dir = Config.dir(getContext());
+        File file = dir == null ? null : new File(dir, FILE_NAME);
+        removeAllViews();
+        if (file != null && file.isFile() && file.length() <= 8192) {
+            try {
+                JSONObject weather = new JSONObject(new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8));
+                long now = System.currentTimeMillis();
+                long expires = weather.getLong("expires_at");
+                if (expires > now / 1000L) {
+                    if (backdrop == null) show(weather);
+                    else showCompact(weather);
+                    if (backdrop != null) backdrop.setCondition(currentIcon);
+                    setVisibility(VISIBLE);
+                    long seconds = Math.min(expires - now / 1000L, Integer.MAX_VALUE);
+                    postDelayed(refresh, seconds * 1000L - now % 1000L);
+                    invalidate();
+                    return;
+                }
+            } catch (IOException | JSONException ignored) {
+                removeAllViews();
+            }
+        }
+        currentIcon = "";
+        if (backdrop != null) {
+            backdrop.setCondition(currentIcon);
+            addView(label(getResources().getString(R.string.weather_label), 20, Color.WHITE, Gravity.START));
+            addView(label(getResources().getString(R.string.weather_unavailable), 17, SECONDARY, Gravity.START));
+        }
+        setVisibility(backdrop != null ? VISIBLE : GONE);
+        invalidate();
+    }
+
+    private void show(JSONObject weather) throws JSONException {
+        currentIcon = weather.getString("icon");
+        LinearLayout heading = row();
+        heading.addView(label(symbol(currentIcon), 32, ACCENT, Gravity.START));
+        LinearLayout place = column(heading, 1);
+        place.addView(label(weather.getString("city"), 18, Color.WHITE, Gravity.END));
+        place.addView(label(weather.getString("condition"), 13, SECONDARY, Gravity.END));
+
+        LinearLayout readings = row();
+        readings.setGravity(Gravity.BOTTOM);
+        readings.setPadding(0, dp(8), 0, 0);
+        LinearLayout current = column(readings, 2);
+        current.addView(label(degrees(weather, "temperature"), 42, Color.WHITE, Gravity.START));
+        current.addView(label(getResources().getString(R.string.weather_feels_like,
+                degrees(weather, "feels_like")), 12, SECONDARY, Gravity.START));
+
+        JSONArray hours = weather.getJSONArray("hours");
+        if (hours.length() != 4) throw new JSONException("Expected four forecast hours");
+        for (int i = 0; i < hours.length(); i++) {
+            JSONObject hour = hours.getJSONObject(i);
+            LinearLayout forecast = column(readings, 1);
+            forecast.addView(label(degrees(hour, "temperature"), 15, Color.WHITE, Gravity.CENTER));
+            TextView icon = label(symbol(hour.getString("icon")), 20, ACCENT, Gravity.CENTER);
+            icon.setContentDescription(hour.getString("condition"));
+            forecast.addView(icon);
+            forecast.addView(label(hour.getString("time"), 12, SECONDARY, Gravity.CENTER));
+        }
+    }
+
+    private void showCompact(JSONObject weather) throws JSONException {
+        currentIcon = weather.getString("icon");
+        LinearLayout readings = row();
+        readings.setGravity(Gravity.CENTER_VERTICAL);
+        LinearLayout current = column(readings, 3);
+        current.addView(label(weather.getString("city"), 17, Color.WHITE, Gravity.START));
+        current.addView(label(symbol(currentIcon) + " " + degrees(weather, "temperature"), 23, ACCENT, Gravity.START));
+        current.addView(label(weather.getString("condition"), 13, SECONDARY, Gravity.START));
+        JSONArray hours = weather.getJSONArray("hours");
+        if (hours.length() != 4) throw new JSONException("Expected four forecast hours");
+        for (int i = 0; i < hours.length(); i++) {
+            JSONObject hour = hours.getJSONObject(i);
+            LinearLayout forecast = column(readings, 1);
+            forecast.addView(label(degrees(hour, "temperature"), 17, Color.WHITE, Gravity.CENTER));
+            TextView icon = label(symbol(hour.getString("icon")), 17, ACCENT, Gravity.CENTER);
+            icon.setContentDescription(hour.getString("condition"));
+            forecast.addView(icon);
+            forecast.addView(label(hour.getString("time"), 14, SECONDARY, Gravity.CENTER));
+        }
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (backdrop != null) return;
+        switch (currentIcon) {
+            case "rain":
+            case "storm":
+                precipitation.setColor(0x7081D6F2);
+                precipitation.setStrokeWidth(dp(1));
+                precipitation.setStrokeCap(Paint.Cap.ROUND);
+                for (int i = 0; i < 3; i++) {
+                    float x = getWidth() * (0.32f + i * 0.09f);
+                    float y = dp(25 + (i % 2) * 10);
+                    canvas.drawLine(x, y, x - dp(3), y + dp(7), precipitation);
+                }
+                break;
+            case "snow":
+                precipitation.setColor(0x99E3F2FF);
+                precipitation.setTextSize(dp(11));
+                canvas.drawText("❄︎", getWidth() * 0.35f, dp(33), precipitation);
+                canvas.drawText("❄︎", getWidth() * 0.47f, dp(43), precipitation);
+                break;
+            default:
+                break;
+        }
+    }
+
+    private LinearLayout row() {
+        LinearLayout row = new LinearLayout(getContext());
+        row.setBaselineAligned(false);
+        addView(row, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));
+        return row;
+    }
+
+    private LinearLayout column(LinearLayout row, int weight) {
+        LinearLayout column = new LinearLayout(getContext());
+        column.setOrientation(VERTICAL);
+        row.addView(column, new LayoutParams(0, LayoutParams.WRAP_CONTENT, weight));
+        return column;
+    }
+
+    private TextView label(String text, int size, int color, int gravity) {
+        TextView label = new TextView(getContext());
+        label.setText(text);
+        label.setTextSize(size * cardScale);
+        label.setTextColor(color);
+        label.setGravity(gravity);
+        label.setTypeface(Typeface.create("sans-serif", Typeface.NORMAL));
+        label.setSingleLine(true);
+        label.setEllipsize(TextUtils.TruncateAt.END);
+        return label;
+    }
+
+    private static String degrees(JSONObject reading, String key) throws JSONException {
+        return reading.getInt(key) + "°";
+    }
+
+    private static String symbol(String icon) {
+        switch (icon) {
+            case "clear": return "☀︎";
+            case "rain": return "☂︎";
+            case "snow": return "❄︎";
+            case "storm": return "ϟ";
+            default: return "☁︎";
+        }
+    }
+
+    private int dp(int value) {
+        return Math.round(value * cardScale * getResources().getDisplayMetrics().density);
+    }
+}
