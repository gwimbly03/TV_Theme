@@ -0,0 +1,63 @@
+package com.gathin.tvhome;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Typeface;
+import android.os.SystemClock;
+import android.view.View;
+
+/** Sparse, translucent glyph trails rendered behind the screensaver clock. */
+final class DigitalRain extends View {
+    private static final String GLYPHS = "01ナミキホヤエフワヲコソニハ";
+    private static final int COLUMNS = 13;
+    private static final long FRAME_MS = 80;
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final float lineHeight;
+    private final boolean motion;
+    private boolean running;
+    private long startedAt;
+
+    DigitalRain(Context context, boolean motion) {
+        super(context);
+        this.motion = motion;
+        float density = getResources().getDisplayMetrics().density;
+        lineHeight = 15 * density;
+        paint.setTextSize(12 * density);
+        paint.setTextAlign(Paint.Align.CENTER);
+        paint.setTypeface(Typeface.MONOSPACE);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        setVisibility(GONE);
+    }
+
+    void setRunning(boolean running) {
+        if (this.running == running) return;
+        this.running = running;
+        if (running) startedAt = SystemClock.uptimeMillis();
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        if (!running) return;
+        boolean animate = motion && ValueAnimator.areAnimatorsEnabled();
+        long elapsed = animate ? SystemClock.uptimeMillis() - startedAt : 0;
+        for (int column = 0; column < COLUMNS; column++) {
+            float x = getWidth() * (column + 0.6f + (column % 3) * 0.12f) / COLUMNS;
+            float length = (6 + column % 5) * lineHeight;
+            float travel = getHeight() + length;
+            float head = (column * 0.381966f * travel + elapsed * lineHeight * (0.003f + (column % 4) * 0.0009f))
+                    % travel;
+            int headRow = (int) (head / lineHeight);
+            for (int trail = 0; trail < 6 + column % 5; trail++) {
+                float y = (headRow - trail) * lineHeight;
+                if (y < 0 || y > getHeight() + lineHeight) continue;
+                int glyph = Math.floorMod(column * 7 + (headRow - trail) * 11 + trail, GLYPHS.length());
+                paint.setColor(trail == 0 ? 0x997BFAC0 : 0x0043EA95 | ((62 - 6 * trail) << 24));
+                canvas.drawText(GLYPHS, glyph, glyph + 1, x, y, paint);
+            }
+        }
+        if (animate && isShown()) postInvalidateDelayed(FRAME_MS);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/ResourceGauges.java b/launcher/app/src/main/java/com/gathin/tvhome/ResourceGauges.java
new file mode 100644
index 00000000..92aa8dc3
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/ResourceGauges.java
@@ -0,0 +1,222 @@
+package com.gathin.tvhome;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.os.SystemClock;
+import java.text.NumberFormat;
+import android.util.AttributeSet;
+import android.view.animation.LinearInterpolator;
+import android.widget.TextView;
+
+/** Two resource cards with animated, bottom-up liquid fills. */
+public final class ResourceGauges extends TextView {
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Typeface cardTypeface = Typeface.create(Typeface.SANS_SERIF, Typeface.BOLD);
+    private final Path path = new Path();
+    private final RectF track = new RectF();
+    private final float density;
+    private float cardScale = 1f;
+    private boolean showNetwork;
+    private String upload = "—";
+    private String download = "—";
+    private int ramColor = 0xFFCCD7F8;
+    private int networkColor = 0xFF53647F;
+    private int diskColor = 0xFFABB8EC;
+    private ValueAnimator animator;
+    private float memory;
+    private float storage;
+    private boolean wavesRunning;
+    private float waveProgress = 1f;
+    private String memoryValue = "";
+    private String storageFree = "";
+    private String storageUsed = "";
+
+    public ResourceGauges(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        density = getResources().getDisplayMetrics().density;
+        setCardScale(1f);
+    }
+
+    void setCardScale(float scale) {
+        cardScale = scale;
+        setMinWidth(Math.round((showNetwork ? 617 : 408) * density * scale));
+        setMinHeight(Math.round(106 * density * scale));
+    }
+
+    void showNetworkRates() {
+        showNetwork = true;
+        setCardScale(cardScale);
+    }
+
+    void setNetworkRates(String up, String down) {
+        upload = up;
+        download = down;
+        invalidate();
+    }
+
+    void setWallpaperAccent(int accent) {
+        networkColor = MainActivity.tint(accent, 0x37445B, accent == 0 ? 0f : 0.23f, 255);
+        ramColor = MainActivity.tint(accent, 0xF5F5FF, accent == 0 ? 0f : 0.45f, 255);
+        diskColor = MainActivity.tint(accent, 0xDBE0FA, accent == 0 ? 0f : 0.55f, 255);
+        if (accent == 0) {
+            ramColor = 0xFFCCD7F8;
+            diskColor = 0xFFABB8EC;
+        }
+        invalidate();
+    }
+
+    void setWavesRunning(boolean running) {
+        wavesRunning = running;
+        invalidate();
+    }
+
+    void update(String description, String ramUsed, String diskFree, float memoryTarget,
+                float storageTarget, boolean animate) {
+        setContentDescription(description);
+        memoryValue = ramUsed;
+        storageFree = diskFree;
+        storageUsed = NumberFormat.getPercentInstance(
+                getResources().getConfiguration().getLocales().get(0)).format(storageTarget);
+        if (animator != null) animator.cancel();
+        if (!animate || (memory == memoryTarget && storage == storageTarget)) {
+            memory = memoryTarget;
+            storage = storageTarget;
+            waveProgress = 1f;
+            invalidate();
+            return;
+        }
+        float memoryStart = memory;
+        float storageStart = storage;
+        animator = ValueAnimator.ofFloat(0f, 1f);
+        animator.setDuration(900L);
+        animator.setInterpolator(new LinearInterpolator());
+        animator.addUpdateListener(value -> {
+            waveProgress = (float) value.getAnimatedValue();
+            float remaining = 1f - waveProgress;
+            float progress = 1f - remaining * remaining * remaining;
+            memory = memoryStart + (memoryTarget - memoryStart) * progress;
+            storage = storageStart + (storageTarget - storageStart) * progress;
+            invalidate();
+        });
+        animator.start();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        boolean animate = wavesRunning && isShown() && hasWindowFocus()
+                && ValueAnimator.areAnimatorsEnabled();
+        double phase = animate ? (SystemClock.uptimeMillis() % 2100L) * (2 * Math.PI / 2100) : 0;
+        float gap = 10 * density;
+        float width = getWidth() / cardScale;
+        float cardWidth = (width - (showNetwork ? 2 : 1) * gap) / (showNetwork ? 3 : 2);
+        float diskLeft = cardWidth + gap;
+        int saved = canvas.save();
+        canvas.scale(cardScale, cardScale);
+        drawCard(canvas, 0, cardWidth, memory, ramColor,
+                getResources().getString(R.string.gauge_ram), "", memoryValue, phase);
+        drawCard(canvas, diskLeft, diskLeft + cardWidth, storage, diskColor,
+                getResources().getString(R.string.gauge_disk), storageFree, storageUsed, phase + Math.PI / 2);
+        if (showNetwork) drawNetwork(canvas, 2 * (cardWidth + gap), width, phase + Math.PI);
+        canvas.restoreToCount(saved);
+        if (animate) postInvalidateDelayed(33L);
+    }
+
+    private void drawCard(Canvas canvas, float left, float right, float fraction, int color,
+                          String title, String detail, String value, double phase) {
+        float top = density;
+        float bottom = getHeight() / cardScale - density;
+        float radius = 12 * density;
+        track.set(left + density, top, right - density, bottom);
+        paint.setColor(0xE91C1D2B);
+        canvas.drawRoundRect(track, radius, radius, paint);
+
+        float level = bottom - track.height() * fraction;
+        float clearance = Math.min(level - top, bottom - level);
+        float amplitude = Math.min(clearance, density * (1.5f + 3.5f * (1f - waveProgress)));
+        if (fraction > 0f) {
+            drawLiquid(canvas, level, amplitude, phase, color);
+        }
+
+        paint.setTypeface(cardTypeface);
+        paint.setColor(0xFFE0E4F0);
+        paint.setTextAlign(Paint.Align.RIGHT);
+        paint.setTextSize(12 * density);
+        canvas.drawText(title, right - 13 * density, 22 * density, paint);
+        float baseline = bottom - 13 * density;
+        paint.setColor(level < baseline - 18 * density ? 0xFF161927 : 0xFFF3F5FF);
+        paint.setTextSize(22 * density);
+        canvas.drawText(value, right - 13 * density, baseline, paint);
+        paint.setTextAlign(Paint.Align.LEFT);
+        paint.setTextSize(12 * density);
+        canvas.drawText(detail, left + 13 * density, baseline, paint);
+
+        if (isFocused()) {
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(density);
+            paint.setColor(0xDAE0F8FF);
+            canvas.drawRoundRect(track, radius, radius, paint);
+            paint.setStyle(Paint.Style.FILL);
+        }
+    }
+
+    private void drawNetwork(Canvas canvas, float left, float right, double phase) {
+        float bottom = getHeight() / cardScale - density;
+        track.set(left + density, density, right - density, bottom);
+        paint.setColor(0xE91C1D2B);
+        canvas.drawRoundRect(track, 12 * density, 12 * density, paint);
+        // An activity decoration, not a bandwidth percentage; the two values are the measurements.
+        drawLiquid(canvas, bottom - track.height() * 0.30f, 2.4f * density, phase, networkColor);
+        paint.setTypeface(cardTypeface);
+        paint.setColor(0xFFE0E4F0);
+        paint.setTextAlign(Paint.Align.RIGHT);
+        paint.setTextSize(12 * density);
+        canvas.drawText(getResources().getString(R.string.quick_network), right - 13 * density, 22 * density, paint);
+        paint.setTextAlign(Paint.Align.LEFT);
+        paint.setTextSize(19 * density);
+        canvas.drawText("↑  " + upload, left + 13 * density, 51 * density, paint);
+        canvas.drawText("↓  " + download, left + 13 * density, 81 * density, paint);
+    }
+
+    private void drawLiquid(Canvas canvas, float level, float amplitude, double phase, int color) {
+        int save = canvas.save();
+        path.reset();
+        path.addRoundRect(track, 12 * density, 12 * density, Path.Direction.CW);
+        canvas.clipPath(path);
+        drawWave(canvas, level, amplitude, phase + Math.PI, (color & 0xFFFFFF) | 0x66000000);
+        drawWave(canvas, level, amplitude, phase, color);
+        canvas.restoreToCount(save);
+    }
+
+    private void drawWave(Canvas canvas, float level, float amplitude, double phase, int color) {
+        path.reset();
+        path.moveTo(track.left, track.bottom);
+        final int segments = 24;
+        for (int segment = 0; segment <= segments; segment++) {
+            float position = (float) segment / segments;
+            float x = track.left + position * track.width();
+            float y = level + amplitude * (float) Math.sin(position * Math.PI * 4 - phase);
+            path.lineTo(x, y);
+        }
+        path.lineTo(track.right, track.bottom);
+        path.close();
+        paint.setColor(color);
+        canvas.drawPath(path, paint);
+    }
+
+    @Override
+    public void onWindowFocusChanged(boolean hasWindowFocus) {
+        super.onWindowFocusChanged(hasWindowFocus);
+        if (hasWindowFocus && wavesRunning) invalidate();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (animator != null) animator.cancel();
+        super.onDetachedFromWindow();
+    }
+}
